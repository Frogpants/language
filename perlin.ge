// FULL PERLIN!!!

float fract(float x) {
    return x - floor(x);
}

float fract2(vec2 p) {
    return p - floor(p);
}

float hash(vec2 p) {
    return fract(sin(dot(p, vec2(12.12538, 71.31247))) * 4137.112412);
}

vec2 mix(float a, vec2 b, float x) {
    return a*(1.0 - x) + b*x;
}

float perlin(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract2(p);

    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float d = hash(i + vec2(0.0, 1.0));
    float c = hash(i + vec2(1.0, 1.0));

    vec2 u = f*f*(3.0 - 2.0*f);
    
    return mix(a, b, u.x) + (c - a)*u.y*(1.0 - u.x) + (d - b)*u.x*u.y;
}

perlin(vec2(0.0, 0.0));

print("perlin.ge loaded");