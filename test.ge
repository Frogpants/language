import <window>
import <camera.ge>

window.create(1280, 720, "GE Window Demo");
window.setTitle("Hello World");

vec3 pos = vec3(0.0, 0.0, 0.0);
vec3 vel = vec3(0.0, 0.0, 0.0);

vec3 angle = vec3(0.0, 0.0, 0.0);

void move(float speed) {
    pos.x += speed * sin(angle.x);
    pos.z += speed * cos(angle.z);
}

while (window.isOpen()) {
	window.beginFrame();
	window.clear(0.1, 0.1, 0.12, 1.0);

    float speed = 0.8;

    if (window.keyDown("w")) {
        move(speed);
    }
    if (window.keyDown("s")) {
        move(-speed);
    }
    angle.x += 90.0;
    if (window.keyDown("d")) {
        move(speed);
    }
    if (window.keyDown("a")) {
        move(-speed);
    }
    angle.x -= 90.0;

    vel *= 0.8;
    pos += vel;

	// window.drawRect(pos.x, pos.y, 25, 25, 0.3, 0.7, 1.0, 1.0);

    f = 1280.0 / tan(FOV / 2.0);

    angle.x = window.mouseX() * 0.3;
    angle.y = window.mouseY() * 0.3;

    cam = pos;
    rot = angle;

    vec2 a = goto(vec3(-50.0, -50.0, 100));
    vec2 b = goto(vec3(-50.0, -50.0, 200));
    vec2 c = goto(vec3(50.0, -50.0, 200));
    vec2 d = goto(vec3(50.0, -50.0, 100));

    window.drawLine(a.x, a.y, b.x, b.y, 3, 1.0, 1.0, 1.0, 1.0);
    window.drawLine(b.x, b.y, c.x, c.y, 3, 1.0, 1.0, 1.0, 1.0);
    window.drawLine(c.x, c.y, d.x, d.y, 3, 1.0, 1.0, 1.0, 1.0);
    window.drawLine(d.x, d.y, a.x, a.y, 3, 1.0, 1.0, 1.0, 1.0);


	window.drawCircle(0, 0, 2, 1.0, 1.0, 1.0, 1.0);


	window.drawLine(-500, 300, 500, 300, 3, 0.8, 0.8, 0.2, 1.0);
	window.drawText("Move mouse and close window to exit", -120, 340, 36);


	window.endFrame();
	window.sleep(16);
}
