// 3D Engine Test

vec3 cam = vec3(0.0, 0.0, 0.0);
vec3 rot = vec3(0.0, 0.0, 0.0);

float FOV = 70.0;
float f = 1280.0;

vec3 hitPos = cam;
float closestHitDist = 1000000.0;

vec3 point(float x, float y, float z) {
    vec3 p;
    p.x = x;
    p.y = y;
    p.z = z;
    return p;
}

vec2 goto(vec3 pos) {
    vec3 p = pos - cam;
    p = point(p.x * cos(rot.x) - p.z * sin(rot.x), p.y, p.x * sin(rot.x) + p.z * cos(rot.x));
    p = point(p.x, p.y * cos(rot.y) - p.z * sin(rot.y), p.y * sin(rot.y) + p.z * cos(rot.y));
    p = point(p.x, p.y, max(1.0, p.z));
    float x = f * (p.x / p.z);
    float y = f * (p.y / p.z);
    vec2 result;
    result.x = x;
    result.y = y;
    return result;
}

vec3 rayDirFromRot(vec3 rotAngles) {
    vec3 dir;
    dir.x = sin(rotAngles.x) * cos(rotAngles.y);
    dir.y = sin(rotAngles.y);
    dir.z = cos(rotAngles.x) * cos(rotAngles.y);
    return dir;
}

vec3 SetRayDirection(vec3 dir) {
    float mag2 = dot(dir, dir);
    if (mag2 <= 0.0001) {
        vec3 fwd = vec3(0.0, 0.0, 1.0);
        return fwd;
    }
    return dir;
}

bool rayTriIntersection(vec3 v0, vec3 v1, vec3 v2, vec3 ro, vec3 rdr) {
    float eps = 0.001;
    bool hit = true;

    vec3 rd = SetRayDirection(rayDirFromRot(rdr));

    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    
    vec3 p = cross(rd, e2);
    float det = dot(e1, p);

    // Two-sided test: reject near-parallel rays.
    if (det < eps) {
        if (det > -eps) {
            hit = false;
        }
    }

    float sign = 1.0;
    if (det < 0.0) {
        det = -det;
        sign = -1.0;
    }

    vec3 s = ro - v0;
    float u = dot(s, p) * sign;

    if (u < 0.0) {
        hit = false;
    }
    if (u > det) {
        hit = false;
    }

    vec3 q = cross(s, e1);
    float v = dot(rd, q) * sign;

    if (v < 0.0) {
        hit = false;
    }
    if (u + v > det) {
        hit = false;
    }

    float tScaled = dot(e2, q) * sign;

    // tScaled / det > eps  <=>  tScaled > eps * det
    if (tScaled <= eps * det) {
        hit = false;
    }

    if (hit) {
        float t = tScaled / det;
        if (t < 0.0) {
            hit = false;
        } else {
            if (t < closestHitDist) {
                hitPos = ro + rd * t;
                closestHitDist = t;
            }
        }
    }

    return hit;
}

