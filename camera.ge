// 3D Engine Test

vec3 cam = vec3(0.0, 0.0, 0.0);
vec3 rot = vec3(0.0, 0.0, 0.0);

float FOV = 90.0;
float f = 1280.0;

vec2 goto(vec3 pos) {
    vec3 p = pos - cam;
    p.x = p.x * cos(rot.x) - p.z * sin(rot.x);
    p.z = p.x * sin(rot.x) + p.z * cos(rot.x);
    p.y = p.y * cos(rot.y) - p.z * sin(rot.y);
    p.z = p.y * sin(rot.y) + p.z * cos(rot.y);
    p.z = max(0.1, p.z);
    float x = f * (p.x / p.z);
    float y = f * (p.y / p.z);
    vec2 result;
    result.x = x;
    result.y = y;
    return result;
}

