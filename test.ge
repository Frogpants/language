import <window>
import <camera.ge>
import <perlin.ge>

window.create(1280, 720, "GE Window Demo");
window.setTitle("Hello World");

window.setFPS(60);

vec3 pos = vec3(0.0, 0.0, 0.0);
vec3 vel = vec3(0.0, 0.0, 0.0);

vec3 angle = vec3(0.0, 0.0, 0.0);

void move(float speed) {
    vel.x += speed * sin(angle.x);
    vel.z += speed * cos(angle.x);
}

vec2 point2(float x, float y) {
    vec2 p;
    p.x = x;
    p.y = y;
    return p;
}

list height = [];
int worldSize = 10;

void genWorld(int size) {
    float y1 = 0.0;
    for(int yi = 0; yi < size; ++yi) {
        float x1 = 0.0;
        for(int xi = 0; xi < size; ++xi) {
            height.add(10.0 * perlin(point2(x1, y1)));
            x1 += 1.0;
        }
        y1 += 1.0;
    }
}

genWorld(worldSize);

float findID(int x, int y) {
    return (y * worldSize) + x;
}

while (window.isOpen()) {
	window.beginFrame();
	window.clear(0.1, 0.1, 0.12, 1.0);

    angle.x = window.mouseX() * 0.3;
    angle.y = window.mouseY() * 0.3;

    float speed = 0.8;

    if (window.keyDown("w")) {
        move(speed);
    }
    if (window.keyDown("s")) {
        move(-speed);
    }
    angle.x += 90.0;
    if (window.keyDown("d")) {
        move(speed);
    }
    if (window.keyDown("a")) {
        move(-speed);
    }
    angle.x -= 90.0;

    vel *= 0.8;
    pos += vel;

	// window.drawRect(pos.x, pos.y, 25, 25, 0.3, 0.7, 1.0, 1.0);

    f = 640.0 / tan(FOV / 2.0);

    cam = pos;
    rot = angle;

    float x = 0.0;
    float y = 0.0;
    float z = 0.0;

    for(int i = 0; i < worldSize; ++i) {
        x = 0.0;
        for(int j = 0; j < worldSize; ++j) {
            int id = findID(j, i);
            vec3 p = point(x, 0.1 * y - 5.0, z);
            y = height.get(id);

            float dist = length(p - cam);
            float size = 8 / (dist * 0.05);
            size = max(1.0, size);
            float col = 1.0 - (dist * 0.1);
            //col = min(1.0, max(0.0, col));
            col = clamp(0.0, 1.0, col);

            vec2 screenPos = goto(p);
            window.drawRect(screenPos.x, screenPos.y, size, size, 1.0, 1.0, 1.0, col);
            x += 1.0;
        }
        z += 1.0;
    }

    vec2 a = goto(vec3(-50.0, -50.0, 100));
    vec2 b = goto(vec3(-50.0, -50.0, 200));
    vec2 c = goto(vec3(50.0, -50.0, 200));
    vec2 d = goto(vec3(50.0, -50.0, 100));

    window.drawLine(a.x, a.y, b.x, b.y, 3, 1.0, 1.0, 1.0, 1.0);
    window.drawLine(b.x, b.y, c.x, c.y, 3, 1.0, 1.0, 1.0, 1.0);
    window.drawLine(c.x, c.y, d.x, d.y, 3, 1.0, 1.0, 1.0, 1.0);
    window.drawLine(d.x, d.y, a.x, a.y, 3, 1.0, 1.0, 1.0, 1.0);


	window.drawCircle(0, 0, 2, 1.0, 1.0, 1.0, 1.0);


	window.drawLine(-500, 300, 500, 300, 3, 1.0, 1.0, 1.0, 1.0);
	window.drawText("Move mouse and close window to exit", -120, 340, 36);


	window.endFrame();
	// window.sleep(16);
}
