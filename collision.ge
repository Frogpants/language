
bool box2D(vec2 a, vec2 b, vec2 d1, vec2 d2) {
    vec2 diff = b - a;
    vec2 size = d1 + d2;
    if (diff.x <= size.x) {
        if (diff.y <= size.y) {
            return true;
        }
    }
    return false;
}

bool circle2D(vec2 a, vec2 b, float r1, float r2) {
    float diff = length(b - a);
    float size = r1 + r2;
    if (dif <= size) {
        return true;
    }
    return false;
}